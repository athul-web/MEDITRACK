# Supabase project URL. Use the project root URL, without /rest/v1.
VITE_SUPABASE_URL=""

# Supabase publishable / anon key. This value is safe for the browser only when
# Row Level Security policies are correctly configured in Supabase.
VITE_SUPABASE_ANON_KEY=""

# OSRM routing server used for road distance / drive time.
# Defaults to the public demo server, which is rate limited and not meant for
# production traffic. Point this at your own OSRM instance when you deploy.
VITE_OSRM_BASE_URL="https://router.project-osrm.org"

# OpenStreetMap Nominatim geocoder: turns a typed place ("Aluva") into coordinates.
# The public server allows 1 request/second and light use only; self-host or use a
# hosted provider in production. Set a contact email, as the usage policy requires.
VITE_NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
VITE_NOMINATIM_EMAIL=""
